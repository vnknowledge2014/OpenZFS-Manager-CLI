# Tự động yêu cầu quyền Admin
if (!([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole] "Administrator")) {
    Start-Process powershell.exe "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`"" -Verb RunAs
    Exit
}

function Show-Header {
    Clear-Host
    Write-Host "============================================" -ForegroundColor Cyan
    Write-Host "   🦈 OPENZFS MANAGER (Windows)" -ForegroundColor Cyan
    Write-Host "============================================" -ForegroundColor Cyan
}

function Check-ZFS {
    if (-not (Get-Command zpool -ErrorAction SilentlyContinue)) {
        Write-Host "❌ Chưa cài OpenZFS on Windows!" -ForegroundColor Red; Pause; Exit
    }
}

function Scan-Import {
    Write-Host "--- IMPORT POOL ---" -ForegroundColor Yellow
    $out = zpool import 2>&1
    if ($out -match "no pools available") {
        if ((zpool list).Count -gt 1) {
            Write-Host "✅ Các pool đang online." -ForegroundColor Green
            zpool list
        } else {
            Write-Host "⚠️ Không tìm thấy pool." -ForegroundColor Red
        }
    } else {
        zpool import -a
        Write-Host "✅ Đã import thành công." -ForegroundColor Green
    }
    Pause
}

function Eject-Pool {
    zpool list
    $p = Read-Host "Nhập tên Pool (hoặc 'all')"
    if ($p -eq 'all') { zpool export -a } else { zpool export $p }
    if ($?) { Write-Host "✅ Đã rút an toàn." -ForegroundColor Green }
    Pause
}

function Rename-Pool-Fixed {
    Write-Host "--- ĐỔI TÊN POOL ---" -ForegroundColor Yellow
    zpool list
    $old = Read-Host "Tên cũ"
    $new = Read-Host "Tên MỚI"
    
    Write-Host "🔄 Đang xử lý..." -ForegroundColor Cyan
    zpool export $old
    zpool import $old $new
    
    if ($?) { 
        # Cập nhật mountpoint để đồng bộ metadata
        zfs set mountpoint=/$new $new
        Write-Host "✅ Đã đổi tên thành công: $new" -ForegroundColor Green 
    } else {
        Write-Host "❌ Lỗi khi đổi tên." -ForegroundColor Red
    }
    Pause
}

function Format-Create {
    Write-Host "--- FORMAT & CREATE POOL ---" -ForegroundColor Red
    Get-Disk | Select Number, FriendlyName, Size, PartitionStyle | FT -AutoSize
    $n = Read-Host "Nhập Disk Number"
    if (-not $n) { return }
    if ((Read-Host "🔥 XÓA SẠCH Disk $n? (y/n)") -ne 'y') { return }

    try {
        Clear-Disk -Number $n -RemoveData -RemoveOEM -Confirm:$false -ErrorAction Stop
        $name = Read-Host "Nhập tên Pool mới"
        
        Write-Host "🛠 Đang tạo Pool..." -ForegroundColor Cyan
        zpool create -f -O compression=lz4 -O normalization=formD -O xattr=sa -O atime=off $name "PHYSICALDRIVE$n"
        
        if ($?) { 
            # Set mountpoint chuẩn
            zfs set mountpoint=/$name $name
            Write-Host "✅ Tạo thành công!" -ForegroundColor Green 
        }
    } catch {
        Write-Host "❌ Lỗi: $_" -ForegroundColor Red
    }
    Pause
}

function Scrub-Pool {
    Write-Host "--- SCRUB HEALTH CHECK ---" -ForegroundColor Blue
    zpool list
    $p = Read-Host "Nhập tên pool check sức khỏe"
    if ($p) {
        zpool scrub $p
        Write-Host "✅ Đã bắt đầu tiến trình Scrub." -ForegroundColor Green
    }
    Pause
}


function Snapshot-Manager {
    Write-Host "--- QUẢN LÝ SNAPSHOT ---" -ForegroundColor Blue
    Write-Host "1. 📸 Tạo Snapshot Mới"
    Write-Host "2. 📜 Liệt kê Snapshot"
    Write-Host "3. 🔙 Rollback (Khôi phục)"
    Write-Host "4. 🗑️  Xóa Snapshot"
    Write-Host "0. Quay lại"
    $c = Read-Host "Chọn"
    switch ($c) {
        '1' { $p = Read-Host "Tên Pool/Dataset"; $n = Read-Host "Tên Snap"; zfs snapshot "$p@$n"; if($?){Write-Host "✅ OK" -Fg Green} }
        '2' { zfs list -t snapshot }
        '3' { 
            zfs list -t snapshot
            $s = Read-Host "Nhập tên snapshot (VD: pool@snap)"
            if ($s) { zfs rollback -r $s; if($?){Write-Host "✅ Đã rollback!" -Fg Green} }
         }
        '4' { $s = Read-Host "Nhập tên snapshot cần xóa"; if($s){zfs destroy $s; Write-Host "✅ Đã xóa" -Fg Green} }
    }
    Pause
}

function Fix-Suspended {
    Write-Host "--- FIX SUSPENDED POOL ---" -ForegroundColor Red
    $sus = zpool list -H -o name,health | Select-String "SUSPENDED"
    if (-not $sus) { Write-Host "✅ Không có pool bị treo." -Fg Green; Pause; return }
    
    Write-Host "⚠️ PHÁT HIỆN SUSPENDED: $sus" -Fg Yellow
    Write-Host "1. Clear Errors (Thử kết nối lại)"
    Write-Host "2. Force Export (Cưỡng chế ngắt)"
    $c = Read-Host "Chọn"
    
    $pname = $sus.ToString().Split("`t")[0]
    if ($c -eq '1') { zpool clear $pname; Write-Host "Đã chạy clear." -Fg Cyan }
    if ($c -eq '2') { zpool export -f $pname; Write-Host "Đã chạy export -f." -Fg Cyan }
    Pause
}

function Check-Health {
    Write-Host "--- CHECK SSD HEALTH (SMART) ---" -ForegroundColor Blue
    if (-not (Get-Command smartctl -ErrorAction SilentlyContinue)) {
        Write-Host "❌ Chưa cài smartmontools. Hãy cài đặt để dùng tính năng này." -Fg Red
        Pause; return
    }
    Get-PhysicalDisk | Select FriendlyName, DeviceId, MediaType
    $id = Read-Host "Nhập DeviceId (VD: 1, 2...)"
    if ($id) {
        Write-Host "🔍 Đang đọc SMART..." -Fg Yellow
        smartctl -a "/dev/sd$id" -T permissive | Select-String "Model Family|Device Model|User Capacity|Total_LBAs_Written|Data Units Written|Percentage Used|Media_and_Data_Integrity"
    }
    Pause
}

function Trim-Pool {
    Write-Host "--- SSD TRIM ---" -ForegroundColor Blue
    zpool list
    $p = Read-Host "Nhập tên Pool"
    if ($p) {
        Write-Host "1. Chạy TRIM ngay"
        Write-Host "2. Bật Auto-TRIM"
        $c = Read-Host "Chọn"
        if ($c -eq '1') { zpool trim $p; Write-Host "✅ Đang chạy TRIM ngầm." -Fg Green }
        if ($c -eq '2') { zpool set autotrim=on $p; Write-Host "✅ Đã bật Auto-TRIM." -Fg Green }
    }
    Pause
}

function Dataset-Manager {
    Write-Host "--- DATASET MANAGER ---" -ForegroundColor Blue
    Write-Host "1. Tạo Dataset Mới"
    Write-Host "2. Chỉnh Compression"
    Write-Host "3. Chỉnh Quota"
    $c = Read-Host "Chọn"
    
    if ($c -eq '1') {
        $n = Read-Host "Tên Dataset (VD: tank/Phim)"
        if ($n) { zfs create $n; Write-Host "✅ Đã tạo." -Fg Green }
    }
    if ($c -eq '2') {
        $n = Read-Host "Tên Dataset"
        $v = Read-Host "Compression (lz4/zstd/off)"
        if ($n -and $v) { zfs set compression=$v $n; Write-Host "✅ OK" -Fg Green }
    }
    if ($c -eq '3') {
        $n = Read-Host "Tên Dataset"
        $v = Read-Host "Quota (VD: 500G)"
        if ($n -and $v) { zfs set quota=$v $n; Write-Host "✅ OK" -Fg Green }
    }
    Pause
}

function Replication-Manager {
    Write-Host "--- REPLICATION ---" -ForegroundColor Blue
    Write-Host "Clone A -> B"
    $src = Read-Host "Pool Nguồn"
    $dst = Read-Host "Pool Đích"
    if ($src -and $dst) {
        $snap = "repl_$(Get-Date -Format FileDateTime)"
        Write-Host "🚀 Đang gửi dữ liệu..." -Fg Yellow
        zfs snapshot -r "$src@$snap"
        # PowerShell pipes can be tricky with binary data, using cmd /c for pipe safety
        cmd /c "zfs send -R $src@$snap | zfs receive -F $dst/backup_$src"
        if ($?) {
            Write-Host "✅ Xong." -Fg Green
            zfs destroy -r "$src@$snap"
        } else {
            Write-Host "❌ Lỗi." -Fg Red
        }
    }
    Pause
}

function Migration-Manager {
    Write-Host "--- 🚚 MIGRATION ASSISTANT (Robocopy) ---" -ForegroundColor Blue
    Write-Host "Copy dữ liệu giữa ZFS và ổ ngoài (NTFS/ExFAT)." -ForegroundColor Cyan
    Write-Host ""
    Write-Host "1. 📥 Import: Non-ZFS -> ZFS (Copy VÀO ZFS)"
    Write-Host "2. 📤 Export: ZFS -> Non-ZFS (Copy RA KHỎI ZFS)"
    Write-Host "0. Quay lại"
    $direction = Read-Host "Chọn"
    
    if ($direction -eq '0' -or -not $direction) { return }
    
    if ($direction -eq '1') {
        # IMPORT: Non-ZFS -> ZFS
        $source = Read-Host "Nhập đường dẫn NGUỒN (VD: D:\Data\File.zip)"
        if (-not $source -or -not (Test-Path $source)) {
            Write-Host "❌ Đường dẫn không tồn tại!" -ForegroundColor Red; Pause; return
        }
        
        Write-Host "`n📂 Các Dataset ZFS hiện có:" -ForegroundColor Yellow
        zfs list -o name,mountpoint
        
        $dest = Read-Host "`nNhập đường dẫn ZFS ĐÍCH (VD: Z:\tank\Folder)"
    }
    elseif ($direction -eq '2') {
        # EXPORT: ZFS -> Non-ZFS
        Write-Host "`n📂 Các Dataset ZFS hiện có:" -ForegroundColor Yellow
        zfs list -o name,mountpoint
        
        $source = Read-Host "`nNhập đường dẫn ZFS NGUỒN (VD: Z:\tank\Folder\File.zip)"
        if (-not $source -or -not (Test-Path $source)) {
            Write-Host "❌ Đường dẫn không tồn tại!" -ForegroundColor Red; Pause; return
        }
        
        $dest = Read-Host "Nhập đường dẫn ĐÍCH Non-ZFS (VD: E:\Backup)"
    }
    else {
        Write-Host "❌ Lựa chọn không hợp lệ!" -ForegroundColor Red; Pause; return
    }
    
    if (-not $dest) { return }
    
    # Confirm
    Write-Host "`n⚠️  SẮP COPY:" -ForegroundColor Yellow
    Write-Host "   Từ: $source" -ForegroundColor Cyan
    Write-Host "   Đến: $dest" -ForegroundColor Cyan
    $confirm = Read-Host "Tiếp tục? (yes/no)"
    if ($confirm -ne 'yes') { Write-Host "Đã hủy." -ForegroundColor Red; Pause; return }
    
    # Execute robocopy
    Write-Host "`n🚀 Đang chạy Robocopy..." -ForegroundColor Green
    Write-Host "   Flags: /E /Z /J /MT:16 /R:3 /W:5" -ForegroundColor Gray
    Write-Host ""
    
    robocopy $source $dest /E /Z /J /MT:16 /R:3 /W:5 /NP /ETA
    
    $exitCode = $LASTEXITCODE
    if ($exitCode -lt 8) {
        Write-Host "`n✅ Copy hoàn tất!" -ForegroundColor Green
    } else {
        Write-Host "`n❌ Có lỗi xảy ra (Exit code: $exitCode)" -ForegroundColor Red
    }
    Pause
}

function Repair-Manager {
    Write-Host "--- REPAIR DISK ---" -ForegroundColor Red
    zpool status
    $p = Read-Host "Tên Pool"
    $old = Read-Host "ID Ổ Hỏng (GUID)"
    $new = Read-Host "ID Ổ Mới (PhysicalDrive...)"
    if ($p -and $old -and $new) {
        zpool replace $p $old $new
        Write-Host "✅ Đã chạy lệnh replace. Kiểm tra status để xem resilver." -Fg Green
    }
    Pause
}

function Manage-Arc-Limit {
    Write-Host "--- QUẢN LÝ BỘ NHỚ CACHE ZFS (ARC LIMIT) ---" -ForegroundColor Blue
    
    # Lấy thông tin RAM vật lý
    $computerSystem = Get-CimInstance CIM_ComputerSystem
    $physRAMBytes = $computerSystem.TotalPhysicalMemory
    $physRAMGB = [Math]::Round($physRAMBytes / 1GB)
    
    # Lấy giới hạn ARC hiện tại từ Environment Variable
    $currentARCObject = [Environment]::GetEnvironmentVariable("zfs_arc_max", "Machine")
    
    Write-Host "   - Tổng dung lượng RAM vật lý: $physRAMGB GB" -ForegroundColor Green
    if ($null -eq $currentARCObject -or $currentARCObject -eq "0") {
        Write-Host "   - Giới hạn ARC hiện tại: Mặc định hệ thống" -ForegroundColor Yellow
    } else {
        $currentARCGB = [Math]::Round([int64]$currentARCObject / 1GB)
        Write-Host "   - Giới hạn ARC hiện tại: $currentARCGB GB ($currentARCObject bytes)" -ForegroundColor Green
    }
    Write-Host "--------------------------------------------------------"
    Write-Host "Nhập giới hạn RAM tối đa mới cho ARC (đơn vị GB, VD: 8, 12, 16):"
    Write-Host "*(Nhập '0' hoặc 'none' để đưa về mặc định của hệ thống)*"
    $newLimit = Read-Host "Chọn"
    
    if (-not $newLimit) { return }
    
    $newLimitBytes = 0
    if ($newLimit -match '^[0-9]+$') {
        if ([int]$newLimit -eq 0) {
            $newLimitBytes = 0
        } else {
            $newLimitBytes = [int64]$newLimit * 1GB
        }
    } elseif ($newLimit -eq 'none') {
        $newLimitBytes = 0
    } else {
        Write-Host "❌ Lỗi: Giới hạn không hợp lệ. Phải là một số nguyên dương." -ForegroundColor Red
        Pause; return
    }
    
    Write-Host "🔄 Đang áp dụng cấu hình..." -ForegroundColor Cyan
    try {
        if ($newLimitBytes -eq 0) {
            [Environment]::SetEnvironmentVariable("zfs_arc_max", $null, "Machine")
            Write-Host "✅ Đã xóa giới hạn ARC (sử dụng mặc định hệ thống)." -ForegroundColor Green
        } else {
            [Environment]::SetEnvironmentVariable("zfs_arc_max", $newLimitBytes.ToString(), "Machine")
            Write-Host "✅ Đã thiết lập giới hạn ARC vĩnh viễn là $newLimit GB ($newLimitBytes bytes)." -ForegroundColor Green
        }
        Write-Host "⚠️ Lưu ý: Bạn cần KHỞI ĐỘNG LẠI MÁY để thiết lập có hiệu lực trên Windows!" -ForegroundColor Yellow
    } catch {
        Write-Host "❌ Lỗi khi ghi cấu hình: $_" -ForegroundColor Red
    }
    Pause
}

function Show-Status {
    Write-Host "--- ZPOOL STATUS ---" -ForegroundColor Blue
    zpool status -v
    Pause
}

# --- MAIN LOOP ---
Check-ZFS
do {
    Show-Header
    Write-Host "1. 🔌 Import Pool"
    Write-Host "2. ⏏️  Eject Pool"
    Write-Host "3. 🛠  Format & Tạo Pool"
    Write-Host "4. 🏥 Scrub Health Check"
    Write-Host "5. 🏷  Đổi tên Pool"
    Write-Host "6. 📊 Zpool Status"
    Write-Host "7. 📸 Quản lý Snapshot"
    Write-Host "8. 🚑 Fix Suspended Pool"
    Write-Host "9. 🌡️  Check SSD Health"
    Write-Host "------------------------------"
    Write-Host "10. ⚡ SSD TRIM"
    Write-Host "11. 🗂️  Dataset Manager"
    Write-Host "12. 🚀 Replication"
    Write-Host "13. 🛠️  Replace Bad Disk"
    Write-Host "14. 🚚 Migration (Robocopy)"
    Write-Host "15. 🧠 Quản lý RAM Cache ZFS (ARC Limit)"
    Write-Host "0. ❌ Thoát"
    
    $c = Read-Host "Chọn chức năng"
    switch ($c) {
        '1' { Scan-Import }
        '2' { Eject-Pool }
        '3' { Format-Create }
        '4' { Scrub-Pool }
        '5' { Rename-Pool-Fixed }
        '6' { Show-Status }
        '7' { Snapshot-Manager }
        '8' { Fix-Suspended }
        '9' { Check-Health }
        '10' { Trim-Pool }
        '11' { Dataset-Manager }
        '12' { Replication-Manager }
        '13' { Repair-Manager }
        '14' { Migration-Manager }
        '15' { Manage-Arc-Limit }
        '0' { Exit }
    }
} while ($true)
